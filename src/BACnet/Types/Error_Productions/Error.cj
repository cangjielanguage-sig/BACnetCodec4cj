public class Error {
    private var _error_class: UInt8 = 0u8 // ENUMERATED {
    private var _error_code: UInt8 = 0u8 // ENUMERATED { -- see below for numerical order

    public mut prop error_class: UInt8 {
        get() { return _error_class }
        set(arg_Value) { _error_class = arg_Value }
    }
    public mut prop error_code: UInt8 {
        get() { return _error_code }
        set(arg_Value) { _error_code = arg_Value }
    }

    public init() {
    }

    public init(arg_error_class: UInt8, arg_error_code: UInt8) {
        this._error_class = arg_error_class
        this._error_code = arg_error_code
    }
}

